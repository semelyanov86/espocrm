# Private settings of the local EspoCRM stand. TEMPLATE ONLY — the real file is generated by
# `task stand:install` at $STAND_PRIVATE_ENV (default /data/itvolga/espo-private/stand/local.env,
# mode 0600, outside Git) with random values. Never commit the real file.
#
# MySQL root of the stand instance uses auth_socket (OS root via sudo), so it has no password.

# Password of the MySQL account '$DB_USER'@'127.0.0.1' used by EspoCRM.
DB_PASSWORD=changeme
# EspoCRM administrator created by the CLI installer.
ESPO_ADMIN_USERNAME=admin
ESPO_ADMIN_PASSWORD=changeme
