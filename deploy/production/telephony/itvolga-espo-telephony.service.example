# AMI listener of the EspoCRM telephony on the production server (stage 07.1; applied only at stage 10 through
# Ansible, stage 09 decides the user, the PHP binary and the EspoCRM path). Unlike the stand it starts at boot:
# the production PBX always runs. Placeholders: <espo-user>, <php-bin>, <espo-root>, <mysql-unit>.
[Unit]
Description=AMI listener of the EspoCRM telephony
After=network.target asterisk.service <mysql-unit>.service
Wants=<mysql-unit>.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=<espo-user>
Group=<espo-user>
WorkingDirectory=<espo-root>
ExecStart=<php-bin> <espo-root>/command.php itvolga-telephony-listen
Restart=always
RestartSec=5
RestartPreventExitStatus=78
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0007
SyslogIdentifier=itvolga-espo-telephony

[Install]
WantedBy=multi-user.target
