; {{ ansible_managed }}
; Dedicated PHP-FPM {{ espocrm_php_version }} master of EspoCRM (role espocrm; the stand: deploy/local/templates/php-fpm.conf.tmpl).
; Separate from php{{ espocrm_php_version }}-fpm (Firefly, Mautic): EspoCRM restarts never touch other sites.
[global]
pid = {{ espocrm_fpm_run_dir }}/php-fpm.pid
error_log = syslog
syslog.ident = {{ espocrm_fpm_unit }}
log_level = notice

[espocrm]
user = {{ espocrm_user }}
group = {{ espocrm_user }}
; Only Apache (www-data) may talk FastCGI to this pool.
listen = {{ espocrm_fpm_socket }}
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = {{ espocrm_fpm_max_children }}
pm.process_idle_timeout = 60s
pm.max_requests = 500
request_terminate_timeout = 300s
security.limit_extensions = .php
catch_workers_output = yes
decorate_workers_output = no
clear_env = yes
env[PATH] = {{ espocrm_path }}
; EspoCRM recommendations (docs.espocrm.com, server-configuration); the stock php.ini values are too low.
php_admin_value[memory_limit] = {{ espocrm_php_memory_limit }}
php_admin_value[max_execution_time] = {{ espocrm_php_max_execution_time }}
php_admin_value[max_input_time] = {{ espocrm_php_max_execution_time }}
php_admin_value[post_max_size] = {{ espocrm_upload_max_size }}
php_admin_value[upload_max_filesize] = {{ espocrm_upload_max_size }}
php_admin_value[date.timezone] = UTC
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
