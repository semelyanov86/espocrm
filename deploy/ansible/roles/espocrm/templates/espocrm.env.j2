# {{ ansible_managed }}
# Settings of the EspoCRM maintenance tools (/usr/local/sbin/espocrm-*, role espocrm). No secrets.
ESPO_ROOT={{ espocrm_root | quote }}
ESPO_USER={{ espocrm_user | quote }}
ESPO_VERSION={{ espocrm_version | quote }}
ESPO_PATH={{ espocrm_path | quote }}
PHP_VERSION={{ espocrm_php_version | quote }}
PHP_BIN={{ espocrm_php_bin | quote }}
DB_NAME={{ espocrm_db_name | quote }}
FPM_UNIT={{ espocrm_fpm_unit | quote }}
TELEPHONY_UNIT={{ espocrm_telephony_unit | quote }}
TELEPHONY_ENABLED={{ '1' if espocrm_telephony_enabled | bool else '0' }}
RECORDINGS_DIR={{ espocrm_recordings_dir | quote }}
CRON_FILE={{ espocrm_cron_file | quote }}
BACKUP_DIR={{ espocrm_backup_dir | quote }}
STATE_DIR={{ espocrm_state_dir | quote }}
LIB_DIR={{ espocrm_lib_dir | quote }}
SBIN_DIR={{ espocrm_sbin_dir | quote }}
SETTINGS_FILE={{ espocrm_settings_file | quote }}
OPS_LOCK={{ espocrm_ops_lock | quote }}
SERVER_NAME={{ espocrm_server_name | quote }}
CRM_MODE={{ espocrm_mode | quote }}
SITE_URL={{ espocrm_site_url | trim | quote }}
PREVIEW_URL={{ espocrm_preview_url | quote }}
PREVIEW_CONNECT={{ (espocrm_preview_address ~ ':' ~ espocrm_preview_port) | quote }}
PUBLIC_URL={{ espocrm_public_url | quote }}
PUBLIC_CONNECT=127.0.0.1:443
TLS_CERT={{ espocrm_tls_cert | quote }}
HEALTH_CA_FILE={{ espocrm_health_ca_file | quote }}
CLEANUP_DELETED_RECORDS={{ '1' if espocrm_cleanup_deleted_records | bool else '0' }}
APACHE_SITES_ENABLED=/etc/apache2/sites-enabled
VTIGER_VHOST={{ espocrm_vtiger_vhost | quote }}
