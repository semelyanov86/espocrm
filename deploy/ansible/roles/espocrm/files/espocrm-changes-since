#!/usr/bin/env bash
# What changed in EspoCRM after a moment (role espocrm, rollback runbook, D-188). Read only for the live database
# (READ ONLY sessions); the console shows counts per table, --export writes the changed rows to
# $BACKUP_DIR/changes-<time>.tsv (600, the server only) — the list for re-entering the work of the switched period after
# a rollback. The export holds no values: only the id, the links (*_id columns that hold an EspoCRM id, *_type), the
# Vtiger key (vtiger_id), the deleted flag and the times of each row; the record itself is opened in EspoCRM by its id
# (AGENTS.md: access fields, names and secrets never in reports — anydesk_id, message_id, request_id are not links).
#
#   espocrm-changes-since '2026-11-01 18:00:00' [--export]
#       per table with created_at / modified_at / deleted: rows created, modified (created before) and soft-deleted at
#       or after the moment (UTC, as EspoCRM stores it; the moment itself is included — take it just before the
#       switch). Misses what has no timestamp: links of many-to-many tables, hard deletes, rows without modified_at.
#   espocrm-changes-since --against <bundle-dir|name> [--export]
#       the full comparison with the state of a bundle (the cutover bundle = the moment of the switch): its dump goes
#       into a temporary database (sql_log_bin=0, dropped at the end); for every table with an id — rows added,
#       removed (hard deletes, unlinked links) and changed (any column, NULL-safe: the JSON of the common columns).
#       The writers (telephony listener, cron, PHP-FPM) are paused for the comparison, so no row lands between the
#       tables; --keep-writers-paused (the rollback, cutover.md §3) leaves them paused until the next run of the role
#       (task crm:switch starts them): nothing written after the list may be missing from it.
# shellcheck source=/dev/null
source /usr/local/lib/espocrm/lib.sh
require_root

since="" against="" export=0 keep_paused=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --export) export=1 ;;
        --keep-writers-paused) keep_paused=1 ;;
        --against) against="${2:?}"; shift ;;
        -*) die "unknown option $1" ;;
        *) since="$1" ;;
    esac
    shift
done
if [[ -z "$against" ]]; then
    [[ "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] \
        || die "usage: espocrm-changes-since 'YYYY-MM-DD HH:MM:SS' [--export] | --against <bundle> [--export] [--keep-writers-paused]"
    [[ $keep_paused == 0 ]] || die "--keep-writers-paused goes with --against"
fi

# Journals EspoCRM writes on its own; their rows are not user work.
skip="'job','scheduled_job','scheduled_job_log_record','auth_token','auth_log_record','action_history_record',
      'app_log_record','notification','unique_id','array_value','webhook_queue_item','webhook_event_queue_item',
      'email_queue_item','mass_action'"

umask 077
out=""
if [[ $export == 1 ]]; then
    out="$BACKUP_DIR/changes-$(date +%Y%m%dT%H%M%S).tsv"
    printf 'table\tchange\tid\trow\n' >"$out"
fi

# JSON_OBJECT of the columns without values: id, deleted, times, the Vtiger key, links (*_id with the type of an EspoCRM
# id — varchar(17); other *_id columns hold values: anydesk_id, message_id, request_id, client_id…) and *_type.
# Arguments: db table alias.
safe_json() {
    mysql_root -N -B <<SQL
SET SESSION group_concat_max_len = 1048576;
SELECT CONCAT('JSON_OBJECT(', GROUP_CONCAT(CONCAT('''', column_name, ''', $3.\`', column_name, '\`')
    ORDER BY ordinal_position SEPARATOR ', '), ')')
FROM information_schema.columns WHERE table_schema = '$1' AND table_name = '$2'
  AND (column_name IN ('id', 'deleted', 'created_at', 'modified_at', 'vtiger_id')
       OR (column_name LIKE '%\\_id' AND column_type = 'varchar(17)') OR column_name LIKE '%\\_type');
SQL
}

# Columns only in the live table / only in the bundle (a deploy after the bundle changed the schema). Arguments: table.
column_diff() {
    mysql_root -N -B <<SQL
SELECT
  (SELECT COUNT(*) FROM information_schema.columns c WHERE c.table_schema = '$DB_NAME' AND c.table_name = '$1'
     AND NOT EXISTS (SELECT 1 FROM information_schema.columns r WHERE r.table_schema = '$ref'
                     AND r.table_name = c.table_name AND r.column_name = c.column_name)),
  (SELECT COUNT(*) FROM information_schema.columns r WHERE r.table_schema = '$ref' AND r.table_name = '$1'
     AND NOT EXISTS (SELECT 1 FROM information_schema.columns c WHERE c.table_schema = '$DB_NAME'
                     AND c.table_name = r.table_name AND c.column_name = r.column_name));
SQL
}

# JSON_OBJECT of every column the live table and the bundle have in common — for the comparison only, never printed.
# Arguments: table alias.
content_json() {
    mysql_root -N -B <<SQL
SET SESSION group_concat_max_len = 1048576;
SELECT CONCAT('JSON_OBJECT(', GROUP_CONCAT(CONCAT('''', c.column_name, ''', $2.\`', c.column_name, '\`')
    ORDER BY c.ordinal_position SEPARATOR ', '), ')')
FROM information_schema.columns c
JOIN information_schema.columns r ON r.table_schema = '$ref' AND r.table_name = c.table_name
     AND r.column_name = c.column_name
WHERE c.table_schema = '$DB_NAME' AND c.table_name = '$1';
SQL
}
total=0

if [[ -z "$against" ]]; then
    tables="$(mysql_root -N -B -e "SELECT c.table_name FROM information_schema.columns c
        WHERE c.table_schema = '$DB_NAME' AND c.column_name = 'created_at' AND c.table_name NOT IN ($skip)
          AND EXISTS (SELECT 1 FROM information_schema.columns m WHERE m.table_schema = c.table_schema
                      AND m.table_name = c.table_name AND m.column_name = 'modified_at')
          AND EXISTS (SELECT 1 FROM information_schema.columns d WHERE d.table_schema = c.table_schema
                      AND d.table_name = c.table_name AND d.column_name = 'deleted')
        ORDER BY c.table_name")"
    printf '%-40s %8s %8s %8s\n' table created modified deleted
    while IFS= read -r t; do
        [[ "$t" =~ ^[a-z0-9_]+$ ]] || continue
        row="$(mysql_root -N -B "$DB_NAME" -e "SET SESSION TRANSACTION READ ONLY; SELECT
            SUM(created_at >= '$since' AND deleted = 0), SUM(created_at < '$since' AND modified_at >= '$since' AND deleted = 0),
            SUM(modified_at >= '$since' AND deleted = 1) FROM \`$t\`")"
        read -r c m d <<<"${row//NULL/0}"
        [[ "$c" == 0 && "$m" == 0 && "$d" == 0 ]] && continue
        printf '%-40s %8s %8s %8s\n' "$t" "$c" "$m" "$d"
        total=$((total + c + m + d))
        if [[ -n "$out" ]]; then
            mysql_root -N -B "$DB_NAME" -e "SET SESSION TRANSACTION READ ONLY; SELECT '$t',
                IF(deleted = 1, 'deleted', IF(created_at >= '$since', 'created', 'modified')), id,
                $(safe_json "$DB_NAME" "$t" r) FROM \`$t\` r WHERE created_at >= '$since' OR modified_at >= '$since'" >>"$out"
        fi
    done <<<"$tables"
    echo "---"
    echo "changes since $since UTC: $total rows${out:+; list: $out}"
    exit 0
fi

# --- the comparison with a bundle ------------------------------------------------------------------------------
if [[ -d "$against" ]]; then dir="$(cd "$against" && pwd)"; else dir="$BACKUP_DIR/bundles/$against"; fi
bundle_verify "$dir"
ops_lock
ref="${DB_NAME}__changes_$(date +%Y%m%dT%H%M%S)"
on_exit() {
    mysql_root -e "DROP DATABASE IF EXISTS \`$ref\`" >/dev/null 2>&1 || true
    if [[ $keep_paused == 1 ]]; then
        log "writers stay paused (listener, cron, PHP-FPM): the next run of the role starts them (task crm:switch)"
    else
        resume_writers
    fi
}
trap on_exit EXIT
log "pausing writers (telephony listener, cron, $FPM_UNIT) for the comparison"
pause_writers
log "importing the dump of $(manifest_get "$dir" name) into $ref (sql_log_bin=0)"
mysql_root -e "CREATE DATABASE \`$ref\` CHARACTER SET $(manifest_get "$dir" db_charset) COLLATE $(manifest_get "$dir" db_collation)"
bundle_cat_db "$dir" | mysql_root --init-command="SET SESSION sql_log_bin=0" "$ref"

tables="$(mysql_root -N -B -e "SELECT t.table_name FROM information_schema.tables t
    WHERE t.table_schema = '$DB_NAME' AND t.table_type = 'BASE TABLE' AND t.table_name NOT IN ($skip)
      AND EXISTS (SELECT 1 FROM information_schema.columns c WHERE c.table_schema = t.table_schema
                  AND c.table_name = t.table_name AND c.column_name = 'id')
    ORDER BY t.table_name")"
printf '%-40s %8s %8s %8s\n' table added removed changed
schema_diff=0
while IFS= read -r t; do
    [[ "$t" =~ ^[a-z0-9_]+$ ]] || continue
    if [[ -z "$(mysql_root -N -B -e "SELECT 1 FROM information_schema.tables WHERE table_schema='$ref' AND table_name='$t'")" ]]; then
        a="$(mysql_root -N -B "$DB_NAME" -e "SET SESSION TRANSACTION READ ONLY; SELECT COUNT(*) FROM \`$t\`")"
        printf '%-40s %8s %8s %8s  (no such table in the bundle)\n' "$t" "$a" 0 0
        total=$((total + a)); schema_diff=$((schema_diff + 1))
        if [[ -n "$out" && "$a" != 0 ]]; then
            mysql_root -N -B -e "SET SESSION TRANSACTION READ ONLY;
                SELECT '$t', 'added', l.id, $(safe_json "$DB_NAME" "$t" l) FROM \`$DB_NAME\`.\`$t\` l" >>"$out"
        fi
        continue
    fi
    read -r only_live only_bundle <<<"$(column_diff "$t")"
    if [[ "$only_live" != 0 || "$only_bundle" != 0 ]]; then
        printf '%-40s columns only live %s, only in the bundle %s: rows compared on the common columns\n' \
            "$t" "$only_live" "$only_bundle"
        schema_diff=$((schema_diff + 1))
    fi
    lj="$(content_json "$t" l)"
    bj="$(content_json "$t" b)"
    row="$(mysql_root -N -B -e "SET SESSION TRANSACTION READ ONLY; SELECT
        (SELECT COUNT(*) FROM \`$DB_NAME\`.\`$t\` l LEFT JOIN \`$ref\`.\`$t\` b ON b.id = l.id WHERE b.id IS NULL),
        (SELECT COUNT(*) FROM \`$ref\`.\`$t\` b LEFT JOIN \`$DB_NAME\`.\`$t\` l ON l.id = b.id WHERE l.id IS NULL),
        (SELECT COUNT(*) FROM \`$DB_NAME\`.\`$t\` l JOIN \`$ref\`.\`$t\` b ON b.id = l.id WHERE $lj <> $bj)")"
    read -r a r c <<<"${row//NULL/0}"
    [[ "$a" == 0 && "$r" == 0 && "$c" == 0 ]] && continue
    printf '%-40s %8s %8s %8s\n' "$t" "$a" "$r" "$c"
    total=$((total + a + r + c))
    if [[ -n "$out" ]]; then
        mysql_root -N -B -e "SET SESSION TRANSACTION READ ONLY;
            SELECT '$t', 'added', l.id, $(safe_json "$DB_NAME" "$t" l) FROM \`$DB_NAME\`.\`$t\` l
                LEFT JOIN \`$ref\`.\`$t\` b ON b.id = l.id WHERE b.id IS NULL;
            SELECT '$t', 'removed', b.id, $(safe_json "$ref" "$t" b) FROM \`$ref\`.\`$t\` b
                LEFT JOIN \`$DB_NAME\`.\`$t\` l ON l.id = b.id WHERE l.id IS NULL;
            SELECT '$t', 'changed', l.id, $(safe_json "$DB_NAME" "$t" l) FROM \`$DB_NAME\`.\`$t\` l
                JOIN \`$ref\`.\`$t\` b ON b.id = l.id WHERE $lj <> $bj" >>"$out"
    fi
done <<<"$tables"
echo "---"
if [[ $schema_diff != 0 ]]; then
    echo "WARNING: the schema of $schema_diff tables differs from the bundle (a deploy after it): values of columns" \
        "the bundle lacks are not compared — check those tables by hand"
fi
echo "changes against $(manifest_get "$dir" name): $total rows${out:+; list: $out}"
