# --- Private migration data: never commit -------------------------------------
# Private audit/import reports, snapshots and hash lists live outside the repo
# (/data/itvolga/espo-private). These patterns are a second line of defence.
/private/
/espo-private/
*.private.*
*-private.*
reports/private/

# Database dumps and data exports
*.sql
*.sql.gz
*.sql.zst
*.dump
*.tsv
*.csv
*.jsonl
*.ndjson
*.xlsx
exports/
snapshots/
*.snapshot.*
*-export.*
# JSON is data by default here; EspoCRM metadata and project manifests are whitelisted
*.json
!custom/Espo/Custom/**/*.json
!client/custom/**/*.json
# test fixtures must be synthetic (AGENTS.md); only this directory is allowed
!tests/fixtures/synthetic/**/*.json
!**/*.example.json
!composer.json
!package.json
!skills-lock.json
# Anonymised maps are the only CSV files that belong in Git
!docs/migration/field-map.csv
!docs/migration/relations.csv
# SQL sources used by the audit are code, not dumps
!scripts/audit/sql/*.sql

# Call recordings, CDR copies, attachments from the source
*.wav
*.WAV
*.mp3
*.gsm
Master.csv*
/storage/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.ovpn
*.kdbx
id_rsa*
id_ed25519*
secrets.*
vault.yml
.vault_pass
htpasswd*

# --- EspoCRM core and runtime (stage 02+). Keep custom/ and client/custom/ tracked ---
# The core of the pinned release is unpacked into the repository root by
# scripts/stand/install.sh (list of entries: .espocrm-core) and is never committed.
/data/
/application/
/bin/
/client/*
!/client/custom/
/html/
/install/
/public/
/vendor/
/.htaccess
/bootstrap.php
/clear_cache.php
/command.php
/cron.php
/daemon.php
/extension.php
/index.php
/LICENSE.txt
/preload.php
/rebuild.php
/upgrade.php
/websocket.php
/.espocrm-core
/node_modules/
/build/

# Tooling
.playwright-mcp/
__pycache__/
*.pyc
.phpunit.result.cache
.idea/
.vscode/
.DS_Store
*.swp
