# rsync exclude list for scripts/audit/sync-vtiger-src.sh: the local copy holds CODE only (no data, secrets or closed extensions).
# data, uploads, runtime
/storage/
/test/
/cache/
/logs/
/backup*/
/user_privileges/
/packages/
/kcfinder/upload/
# secrets and security findings at the root
/config.inc.php*
/config.db.php
/config.csrf-secret.php
/config.security.php
/config_override.php
/config.php
/connection.php
/vtdm.php
/req.php
/uxo.txt
.htpasswd*
# dumps, exports, media, archives
*.sql
*.sql.gz
*.gz
*.zip
*.tar*
*.log
*.csv
*.xls
*.xlsx
*.pdf
*.wav
*.orig
*.bak
