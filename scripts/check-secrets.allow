# Exceptions for scripts/check_secrets.py. Format: <path-glob><TAB><rule>
# Keep this list short and justified; never whitelist real personal data.
#
# Generic words that coincide with single-word CRM values (logins, placeholder names, common nouns).
# They carry no personal information on their own.
pii-word	admin
pii-word	support
pii-word	event
pii-word	google
pii-word	laravel
pii-word	value
pii-word	общий
pii-word	клиент
pii-word	почта
pii-word	текущая
# Owner's OS login (part of the documented SSH target of the source server, given in the task).
pii-word	sergey
# Third-party agent skills (.agents/, installed from public repos): textbook code samples
# (placeholder passwords, private-range IPs, fake e-mails). Verified manually 2026-09-29.
.agents/*	password-assignment
.agents/*	email
.agents/*	ipv4
# Synthetic self-test samples inside the scanner itself (fake values by construction).
scripts/check_secrets.py	password-assignment
scripts/check_secrets.py	email
scripts/check_secrets.py	phone
scripts/check_secrets.py	ipv4
scripts/check_secrets.py	long-digits
scripts/check_secrets.py	github-token
# Field-name constants of the stage-03 ContactAccess entity (the name of the password field, not a value).
custom/Espo/Modules/Itvolga/Entities/ContactAccess.php	password-assignment
