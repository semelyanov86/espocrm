{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 255,
            "required": true
        },
        "number": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "copyToClipboard": true,
            "tooltip": true,
            "layoutMassUpdateDisabled": true
        },
        "vtigerId": {
            "type": "int",
            "readOnly": true,
            "disableFormatting": true,
            "tooltip": true,
            "layoutMassUpdateDisabled": true
        },
        "vtigerData": {
            "type": "jsonObject",
            "readOnly": true,
            "tooltip": true,
            "view": "itvolga:views/fields/vtiger-data",
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "layoutDetailSmallDisabled": true,
            "exportDisabled": true,
            "customizationDisabled": true
        },
        "status": {
            "type": "enum",
            "options": [
                "",
                "AutoCreated",
                "Cancel",
                "Created",
                "Approved",
                "Sent",
                "Credit Invoice",
                "Paid"
            ],
            "default": "Created"
        },
        "account": {
            "type": "link",
            "required": true
        },
        "contact": {
            "type": "link"
        },
        "opportunity": {
            "type": "link"
        },
        "legalEntity": {
            "type": "link",
            "readOnly": true,
            "tooltip": true
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "taxMode": {
            "type": "enum",
            "options": [
                "individual",
                "group",
                "group_tax_inc"
            ],
            "default": "individual",
            "tooltip": true,
            "massUpdateDisabled": true
        },
        "sourceFormula": {
            "type": "enum",
            "options": [
                "",
                "noLineTax",
                "lineTaxNotApplied",
                "taxIncludedInPrice",
                "groupTaxAdded",
                "unverified"
            ],
            "default": "",
            "tooltip": true,
            "readOnly": true,
            "massUpdateDisabled": true
        },
        "totalsCheck": {
            "type": "enum",
            "options": [
                "",
                "exact",
                "rounded",
                "mismatch",
                "unverified"
            ],
            "default": "",
            "tooltip": true,
            "readOnly": true,
            "massUpdateDisabled": true,
            "style": {
                "exact": "success",
                "rounded": "info",
                "mismatch": "danger",
                "unverified": "warning"
            }
        },
        "itemList": {
            "type": "jsonArray",
            "notStorable": true,
            "view": "itvolga:views/finance/fields/item-list",
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "layoutDetailSmallDisabled": true,
            "massUpdateDisabled": true,
            "inlineEditDisabled": true,
            "exportDisabled": true,
            "importDisabled": true,
            "orderDisabled": true,
            "filtersDisabled": true,
            "customizationDisabled": true
        },
        "subtotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true
        },
        "discountAmount": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "min": 0,
            "massUpdateDisabled": true
        },
        "discountPercent": {
            "type": "decimal",
            "precision": 25,
            "scale": 3,
            "min": 0,
            "max": 100,
            "massUpdateDisabled": true
        },
        "shippingAmount": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "min": 0,
            "massUpdateDisabled": true
        },
        "shippingTaxPercent": {
            "type": "decimal",
            "precision": 25,
            "scale": 3,
            "tooltip": true,
            "readOnly": true,
            "massUpdateDisabled": true
        },
        "adjustment": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "tooltip": true,
            "massUpdateDisabled": true
        },
        "preTaxTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true
        },
        "grandTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true
        },
        "expectedSubtotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "expectedPreTaxTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "expectedGrandTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "sourceSubtotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "sourcePreTaxTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "sourceGrandTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "billingAddress": {
            "type": "address"
        },
        "billingAddressStreet": {
            "type": "text",
            "maxLength": 255,
            "dbType": "varchar"
        },
        "billingAddressCity": {
            "type": "varchar"
        },
        "billingAddressState": {
            "type": "varchar"
        },
        "billingAddressCountry": {
            "type": "varchar"
        },
        "billingAddressPostalCode": {
            "type": "varchar"
        },
        "shippingAddress": {
            "type": "address"
        },
        "shippingAddressStreet": {
            "type": "text",
            "maxLength": 255,
            "dbType": "varchar"
        },
        "shippingAddressCity": {
            "type": "varchar"
        },
        "shippingAddressState": {
            "type": "varchar"
        },
        "shippingAddressCountry": {
            "type": "varchar"
        },
        "shippingAddressPostalCode": {
            "type": "varchar"
        },
        "termsAndConditions": {
            "type": "text"
        },
        "description": {
            "type": "text"
        },
        "documents": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "noLoad": true,
            "importDisabled": true,
            "exportDisabled": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "dateInvoiced": {
            "type": "date",
            "required": true,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "dateDue": {
            "type": "date",
            "required": true
        },
        "salesOrder": {
            "type": "link"
        },
        "quote": {
            "type": "link"
        },
        "balanceSource": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "vtigerArchives": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "noLoad": true,
            "importDisabled": true,
            "exportDisabled": true,
            "readOnly": true
        },
        "paidAmount": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "audited": true,
            "tooltip": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "balanceAmount": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "audited": true,
            "tooltip": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "settlementState": {
            "type": "enum",
            "options": [
                "",
                "unpaid",
                "partial",
                "paid",
                "overpaid"
            ],
            "default": "",
            "readOnly": true,
            "audited": true,
            "tooltip": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "style": {
                "unpaid": "default",
                "partial": "warning",
                "paid": "success",
                "overpaid": "info"
            }
        }
    },
    "links": {
        "items": {
            "type": "hasMany",
            "entity": "InvoiceItem",
            "foreign": "invoice",
            "readOnly": true,
            "cascadeRemoval": true,
            "orderBy": "order",
            "order": "asc",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "cInvoices"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "cInvoices"
        },
        "opportunity": {
            "type": "belongsTo",
            "entity": "Opportunity",
            "foreign": "cInvoices"
        },
        "legalEntity": {
            "type": "belongsTo",
            "entity": "LegalEntity"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "documents": {
            "type": "hasMany",
            "entity": "Document",
            "foreign": "cInvoices",
            "relationName": "invoiceDocument"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "salesOrder": {
            "type": "belongsTo",
            "entity": "SalesOrder",
            "foreign": "invoices"
        },
        "quote": {
            "type": "belongsTo",
            "entity": "Quote",
            "foreign": "invoices"
        },
        "vtigerArchives": {
            "type": "hasMany",
            "entity": "VtigerArchive",
            "foreign": "invoice"
        },
        "meetings": {
            "type": "hasChildren",
            "entity": "Meeting",
            "foreign": "parent"
        },
        "calls": {
            "type": "hasChildren",
            "entity": "Call",
            "foreign": "parent"
        },
        "tasks": {
            "type": "hasChildren",
            "entity": "Task",
            "foreign": "parent"
        },
        "emails": {
            "type": "hasChildren",
            "entity": "Email",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true
        },
        "paymentAllocations": {
            "type": "hasMany",
            "entity": "PaymentAllocation",
            "foreign": "invoice",
            "readOnly": true,
            "cascadeRemoval": true,
            "orderBy": "createdAt",
            "order": "asc"
        }
    },
    "transactionalSave": true,
    "optimisticConcurrencyControl": true,
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "number"
        ]
    },
    "indexes": {
        "vtigerId": {
            "type": "unique",
            "columns": [
                "vtigerId"
            ]
        },
        "number": {
            "columns": [
                "number",
                "deleted"
            ]
        },
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        },
        "settlementState": {
            "columns": [
                "settlementState",
                "deleted"
            ]
        }
    }
}
