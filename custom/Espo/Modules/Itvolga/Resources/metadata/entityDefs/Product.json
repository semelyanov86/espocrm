{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 100,
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "vtigerId": {
            "type": "int",
            "readOnly": true,
            "disableFormatting": true,
            "tooltip": true,
            "layoutMassUpdateDisabled": true
        },
        "vtigerNo": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "tooltip": true,
            "layoutMassUpdateDisabled": true
        },
        "vtigerData": {
            "type": "jsonObject",
            "readOnly": true,
            "tooltip": true,
            "view": "itvolga:views/fields/vtiger-data",
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "layoutDetailSmallDisabled": true,
            "exportDisabled": true,
            "customizationDisabled": true
        },
        "type": {
            "type": "enum",
            "options": [
                "product",
                "service"
            ],
            "default": "service"
        },
        "isActive": {
            "type": "bool",
            "default": true
        },
        "code": {
            "type": "varchar",
            "maxLength": 40
        },
        "unitPrice": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "min": 0
        },
        "unit": {
            "type": "enum",
            "options": [
                "",
                "Hours",
                "мес.",
                "Days",
                "Incidents",
                "Box",
                "Carton",
                "Dozen",
                "Each",
                "Impressions",
                "Lb",
                "M",
                "Pack",
                "Pages",
                "Pieces",
                "Quantity",
                "Reams",
                "Sheet",
                "Spiral Binder",
                "Sq Ft"
            ],
            "default": ""
        },
        "qtyPerUnit": {
            "type": "decimal",
            "precision": 11,
            "scale": 2,
            "decimalPlaces": 2,
            "min": 0
        },
        "category": {
            "type": "enum",
            "options": [
                "",
                "Support",
                "Installation",
                "Migration",
                "Customization",
                "Training",
                "Time Logs"
            ],
            "default": ""
        },
        "isBillableTime": {
            "type": "bool",
            "tooltip": true
        },
        "vendor": {
            "type": "link"
        },
        "opportunities": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "noLoad": true,
            "importDisabled": true,
            "exportDisabled": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "vendor": {
            "type": "belongsTo",
            "entity": "Vendor",
            "foreign": "products"
        },
        "opportunities": {
            "type": "hasMany",
            "entity": "Opportunity",
            "foreign": "cProducts",
            "relationName": "cOpportunityProduct"
        },
        "vtigerArchives": {
            "type": "hasMany",
            "entity": "VtigerArchive",
            "foreign": "product"
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc",
        "textFilterFields": [
            "name",
            "code"
        ]
    },
    "indexes": {
        "vtigerId": {
            "type": "unique",
            "columns": [
                "vtigerId"
            ]
        },
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        },
        "type": {
            "columns": [
                "type",
                "deleted"
            ]
        }
    }
}
