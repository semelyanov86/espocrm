{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 100,
            "required": false,
            "tooltip": true,
            "pattern": "$noBadCharacters"
        },
        "vtigerId": {
            "type": "int",
            "readOnly": true,
            "disableFormatting": true,
            "tooltip": true,
            "layoutMassUpdateDisabled": true
        },
        "contact": {
            "type": "link",
            "required": true
        },
        "anydeskId": {
            "type": "varchar",
            "maxLength": 50,
            "copyToClipboard": true
        },
        "anydeskPassword": {
            "type": "password",
            "maxLength": 255,
            "view": "itvolga:views/contact-access/fields/password",
            "tooltip": true,
            "exportDisabled": true,
            "layoutListDisabled": true,
            "layoutFiltersDisabled": true,
            "layoutMassUpdateDisabled": true,
            "customizationDisabled": true
        },
        "hasAnydeskPassword": {
            "type": "bool",
            "readOnly": true,
            "layoutMassUpdateDisabled": true,
            "layoutDetailDisabled": true
        },
        "hostname": {
            "type": "varchar",
            "maxLength": 190,
            "copyToClipboard": true
        },
        "ipAddress": {
            "type": "varchar",
            "maxLength": 100,
            "copyToClipboard": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "cContactAccesses"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "anydeskId",
            "hostname",
            "ipAddress"
        ]
    },
    "indexes": {
        "vtigerId": {
            "type": "unique",
            "columns": [
                "vtigerId"
            ]
        },
        "contact": {
            "columns": [
                "contactId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
