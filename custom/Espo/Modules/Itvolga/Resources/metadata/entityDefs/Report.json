{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 150,
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text",
            "rowsMin": 2
        },
        "folder": {
            "type": "link",
            "view": "views/fields/link-category-tree"
        },
        "type": {
            "type": "enum",
            "options": [
                "tabular",
                "summaries",
                "summariesWithDetails",
                "matrix"
            ],
            "default": "tabular",
            "required": true,
            "readOnlyAfterCreate": true,
            "layoutMassUpdateDisabled": true
        },
        "entityType": {
            "type": "varchar",
            "maxLength": 100,
            "required": true,
            "readOnlyAfterCreate": true,
            "view": "itvolga:views/report/fields/entity-type",
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        },
        "accessType": {
            "type": "enum",
            "options": [
                "private",
                "public",
                "shared"
            ],
            "default": "private",
            "required": true,
            "layoutMassUpdateDisabled": true
        },
        "sharedUsers": {
            "type": "linkMultiple",
            "view": "views/fields/link-multiple",
            "maxCount": 50,
            "layoutMassUpdateDisabled": true,
            "layoutListDisabled": true,
            "layoutFiltersDisabled": true,
            "exportDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true
