        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        }
    },
    "links": {
        "folder": {
            "type": "belongsTo",
            "entity": "ReportFolder",
            "foreign": "reports"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "sharedUsers": {
            "type": "hasMany",
            "entity": "User",
            "relationName": "reportSharedUser",
            "layoutRelationshipsDisabled": true,
            "foreign": "cSharedReports"
        },
        "sharedTeams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "reportSharedTeam",
            "layoutRelationshipsDisabled": true,
            "foreign": "cSharedReports"
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc",
        "textFilterFields": [
            "name",
            "description"
        ]
    },
    "indexes": {
        "seedKey": {
            "type": "unique",
            "columns": [
                "seedKey"
            ]
        },
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        }
    }
}
