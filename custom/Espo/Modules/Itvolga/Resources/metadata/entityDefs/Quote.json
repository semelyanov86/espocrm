            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true
        },
        "expectedSubtotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "expectedPreTaxTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "expectedGrandTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "sourceSubtotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "sourcePreTaxTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "sourceGrandTotal": {
            "type": "currency",
            "decimal": true,
            "precision": 25,
            "scale": 8,
            "onlyDefaultCurrency": true,
            "view": "itvolga:views/fields/money",
            "readOnly": true,
            "massUpdateDisabled": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "billingAddress": {
            "type": "address"
        },
        "billingAddressStreet": {
            "type": "text",
            "maxLength": 255,
            "dbType": "varchar"
        },
        "billingAddressCity": {
            "type": "varchar"
        },
        "billingAddressState": {
            "type": "varchar"
        },
        "billingAddressCountry": {
            "type": "varchar"
        },
        "billingAddressPostalCode": {
            "type": "varchar"
        },
        "shippingAddress": {
            "type": "address"
        },
        "shippingAddressStreet": {
            "type": "text",
            "maxLength": 255,
            "dbType": "varchar"
        },
        "shippingAddressCity": {
            "type": "varchar"
        },
        "shippingAddressState": {
            "type": "varchar"
        },
        "shippingAddressCountry": {
            "type": "varchar"
        },
        "shippingAddressPostalCode": {
            "type": "varchar"
        },
        "termsAndConditions": {
            "type": "text",
            "default": "- Счет действителен на протяжении 14 календарных дней с даты его выставления, если другое не оговорено в письменной форме. Оплата счета Покупателем означает согласие с условиями поставки."
        },
        "description": {
            "type": "text"
        },
        "documents": {
            "type": "linkMultiple",
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "noLoad": true,
            "importDisabled": true,
            "exportDisabled": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "dateValidUntil": {
            "type": "date"
        },
        "inventoryManager": {
            "type": "link",
            "view": "views/fields/user"
        }
    },
    "links": {
        "items": {
            "type": "hasMany",
            "entity": "QuoteItem",
            "foreign": "quote",
            "readOnly": true,
            "cascadeRemoval": true,
            "orderBy": "order",
            "order": "asc",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "cQuotes"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "cQuotes"
        },
        "opportunity": {
            "type": "belongsTo",
            "entity": "Opportunity",
            "foreign": "cQuotes"
        },
        "legalEntity": {
            "type": "belongsTo",
            "entity": "LegalEntity"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "documents": {
            "type": "hasMany",
            "entity": "Document",
            "foreign": "cQuotes",
            "relationName": "quoteDocument"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "inventoryManager": {
            "type": "belongsTo",
            "entity": "User"
        },
        "salesOrders": {
            "type": "hasMany",
            "entity": "SalesOrder",
            "foreign": "quote"
        },
        "invoices": {
            "type": "hasMany",
            "entity": "Invoice",
            "foreign": "quote"
        }
    },
    "transactionalSave": true,
    "optimisticConcurrencyControl": true,
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "number"
        ]
    },
    "indexes": {
        "vtigerId": {
            "type": "unique",
            "columns": [
                "vtigerId"
            ]
        },
        "number": {
            "columns": [
                "number",
                "deleted"
            ]
        },
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
