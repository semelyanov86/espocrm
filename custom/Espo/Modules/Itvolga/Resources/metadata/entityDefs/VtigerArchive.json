{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 255,
            "required": false,
            "pattern": "$noBadCharacters"
        },
        "vtigerId": {
            "type": "int",
            "readOnly": true,
            "disableFormatting": true,
            "tooltip": true,
            "layoutMassUpdateDisabled": true
        },
        "vtigerNo": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "tooltip": true,
            "layoutMassUpdateDisabled": true
        },
        "vtigerModule": {
            "type": "enum",
            "options": [
                "Consignment",
                "ServiceContracts",
                "Assets",
                "Jivosite",
                "JVmes"
            ],
            "readOnly": true,
            "required": true
        },
        "data": {
            "type": "jsonObject",
            "readOnly": true,
            "view": "itvolga:views/fields/vtiger-data",
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "exportDisabled": true
        },
        "recordDate": {
            "type": "datetime",
            "readOnly": true,
            "tooltip": true
        },
        "account": {
            "type": "link",
            "readOnly": true
        },
        "contact": {
            "type": "link",
            "readOnly": true
        },
        "lead": {
            "type": "link",
            "readOnly": true
        },
        "product": {
            "type": "link",
            "readOnly": true
        },
        "parentArchive": {
            "type": "link",
            "readOnly": true
        },
        "childArchives": {
            "type": "linkMultiple",
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "noLoad": true,
            "importDisabled": true,
            "exportDisabled": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "cVtigerArchives"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "cVtigerArchives"
        },
        "lead": {
            "type": "belongsTo",
            "entity": "Lead",
            "foreign": "cVtigerArchives"
        },
        "product": {
            "type": "belongsTo",
            "entity": "Product",
            "foreign": "vtigerArchives"
        },
        "parentArchive": {
            "type": "belongsTo",
            "entity": "VtigerArchive",
            "foreign": "childArchives"
        },
        "childArchives": {
            "type": "hasMany",
            "entity": "VtigerArchive",
            "foreign": "parentArchive"
        },
        "documents": {
            "type": "hasMany",
            "entity": "Document",
            "foreign": "cVtigerArchives",
            "relationName": "vtigerArchiveDocument"
        }
    },
    "collection": {
        "orderBy": "recordDate",
        "order": "desc",
        "textFilterFields": [
            "name",
            "vtigerNo"
        ]
    },
    "indexes": {
        "vtigerId": {
            "type": "unique",
            "columns": [
                "vtigerId"
            ]
        },
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        },
        "vtigerModule": {
            "columns": [
                "vtigerModule",
                "deleted"
            ]
        }
    }
}
